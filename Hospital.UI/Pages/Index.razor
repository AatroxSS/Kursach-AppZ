@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@using System.Net.Http.Json
@using Hospital.BLL.DTO
@inject HttpClient Http
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<PageTitle>Центральна Клінічна Лікарня</PageTitle>

<AuthorizeView>
    <NotAuthorized>
        <div class="container mt-5">
            <div class="text-center mb-5">
                <h1 class="display-4 fw-bold text-primary">🏥 Центральна Клінічна Лікарня</h1>
                <p class="lead text-muted">Сучасна медична допомога та швидкий запис до спеціалістів</p>
            </div>

            <div class="row justify-content-center">
                <div class="col-md-6">
                    <div class="card shadow-lg border-0 rounded-3">
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-center mb-4 border-bottom pb-2">
                                <button class="btn @(isLoginMode ? "btn-primary" : "btn-outline-secondary") me-2 w-50" @onclick="() => SetMode(true)">Увійти</button>
                                <button class="btn @(!isLoginMode ? "btn-success" : "btn-outline-secondary") w-50" @onclick="() => SetMode(false)">Реєстрація</button>
                            </div>

                            @if (!string.IsNullOrEmpty(message))
                            {
                                <div class="alert @(isError ? "alert-danger" : "alert-success") mb-3">@message</div>
                            }

                            @if (isLoginMode)
                            {
                                <EditForm Model="loginModel" OnValidSubmit="HandleLogin" Context="formContext">
                                    <DataAnnotationsValidator />
                                    <div class="mb-3">
                                        <label class="form-label fw-bold">Email:</label>
                                        <InputText @bind-Value="loginModel.Email" class="form-control" placeholder="example@test.com" />
                                    </div>
                                    <div class="mb-4">
                                        <label class="form-label fw-bold">Пароль:</label>
                                        <InputText @bind-Value="loginModel.Password" type="password" class="form-control" />
                                    </div>
                                    <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">Увійти в систему</button>
                                </EditForm>
                            }
                            else
                            {
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Ім'я:</label>
                                    <input type="text" class="form-control" @bind="registerModel.FirstName" placeholder="Іван" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Прізвище:</label>
                                    <input type="text" class="form-control" @bind="registerModel.LastName" placeholder="Іванов" />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Email:</label>
                                    <input type="email" class="form-control" @bind="registerModel.Email" placeholder="ivan@test.com" />
                                </div>
                                <div class="mb-4">
                                    <label class="form-label fw-bold">Пароль:</label>
                                    <input type="password" class="form-control" @bind="registerModel.Password" />
                                </div>
                                <button class="btn btn-success w-100 py-2 fw-bold" @onclick="HandleRegister">Створити акаунт</button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </NotAuthorized>

    <Authorized>
        <div class="container mt-4">
            <div class="alert alert-info">
                👋 Вітаємо, <strong>@context.User.Identity?.Name</strong>! Ваша роль у системі:
                <span class="badge bg-dark">@GetUserRole(context.User)</span>
            </div>

            @if (context.User.IsInRole("RegisteredUser"))
            {
                <h2 class="mt-4 mb-3">🩺 Доступні лікарі клініки</h2>
                <p class="text-muted">Оберіть спеціаліста для перегляду інформації або запису.</p>
                @if (doctors == null)
                {
                    <div class="spinner-border text-primary" role="status"></div>
                }
                else
                {
                    <div class="row">
                        @foreach (var doc in doctors)
                        {
                            <div class="col-md-4 mb-3">
                                <div class="card h-100 shadow-sm border-0 bg-light">
                                    <div class="card-body">
                                        <h5 class="card-title fw-bold text-primary">👨‍⚕️ Д-р. @doc.FirstName @doc.LastName</h5>
                                        <p class="card-text text-secondary">Спеціалізація: Лікар клініки</p>
                                        <a href="/doctor/@doc.Id" class="btn btn-outline-primary btn-sm w-100">Переглянути записи лікаря</a>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }

            @if (context.User.IsInRole("Manager"))
            {
                <div class="card border-0 shadow-sm p-4 bg-light">
                    <h3>👨‍⚕️ Кабінет лікаря</h3>
                    <p>Тут ви можете швидко перейти до перегляду свого розкладу та профілю.</p>
                    <a href="/profile" class="btn btn-success btn-lg">Перейти до моїх записів та профілю</a>
                </div>
            }

            @if (context.User.IsInRole("Administrator"))
            {
                <div class="card border-0 shadow-sm p-4 bg-light border-start border-danger border-4">
                    <h3>⚡ Панель керування адміністратора</h3>
                    <p>Повний контроль над користувачами, ролями та структурою клініки.</p>
                    <a href="/admin" class="btn btn-danger btn-lg">Відкрити Адмін-Панель</a>
                </div>
            }
        </div>
    </Authorized>
</AuthorizeView>

@code {
    private bool isLoginMode = true;
    private string message = "";
    private bool isError = false;

    private Hospital.UI.Models.LoginModel loginModel = new();
    private RegisterModel registerModel = new();
    private List<DoctorDataDTO> doctors;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            await LoadDoctors();
        }
    }

    private void SetMode(bool login)
    {
        isLoginMode = login;
        message = "";
    }

    private async Task LoadDoctors()
    {
        try
        {
            doctors = await Http.GetFromJsonAsync<List<DoctorDataDTO>>("api/Doctors");
        }
        catch { /* Обробити помилку за потреби */ }
    }

    private async Task HandleLogin()
    {
        message = "";
        try
        {
            var response = await Http.PostAsJsonAsync("api/Auth/login", loginModel);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LoginResponseDTO>();
                if (result != null && !string.IsNullOrEmpty(result.Token))
                {
                    await JS.InvokeVoidAsync("localStorage.setItem", "authToken", result.Token);
                    ((Hospital.UI.Providers.CustomAuthStateProvider)AuthStateProvider).MarkUserAsAuthenticated(result.Token);
                    isError = false;
                    message = "Вхід успішний!";
                    await LoadDoctors();
                    StateHasChanged();
                }
            }
            else
            {
                isError = true;
                message = "Невірний Email або пароль.";
            }
        }
        catch
        {
            isError = true;
            message = "Помилка з'єднання з сервером.";
        }
    }

    private async Task HandleRegister()
    {
        message = "";
        try
        {
            var response = await Http.PostAsJsonAsync("api/Auth/register", registerModel);
            if (response.IsSuccessStatusCode)
            {
                isError = false;
                message = "Реєстрація успішна! Тепер ви можете увійти.";
                isLoginMode = true;
                loginModel.Email = registerModel.Email;
            }
            else
            {
                isError = true;
                var err = await response.Content.ReadAsStringAsync();
                message = $"Помилка реєстрації: {err}";
            }
        }
        catch
        {
            isError = true;
            message = "Помилка відправки запиту.";
        }
    }

    private string GetUserRole(System.Security.Claims.ClaimsPrincipal user)
    {
        if (user.IsInRole("Administrator")) return "Адміністратор";
        if (user.IsInRole("Manager")) return "Лікар (Manager)";
        if (user.IsInRole("RegisteredUser")) return "Пацієнт";
        return "Гість";
    }

    public class RegisterModel
    {
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
    }

    public class DoctorDataDTO
    {
        public int Id { get; set; }
        public string FirstName { get; set; }
        public string LastName { get; set; }
    }
}