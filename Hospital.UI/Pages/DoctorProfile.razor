@page "/doctor/{Id:int}"
@using System.Net.Http.Json
@inject HttpClient Http

<div class="container mt-4">
    <a href="/" class="btn btn-sm btn-outline-secondary mb-3">⬅️ Назад до списку лікарів</a>

    @if (doctorAppointments == null)
    {
        <div class="spinner-border text-primary" role="status"></div>
    }
    else
    {
        <div class="card border-0 shadow-lg p-4 bg-light mb-4">
            <h2 class="text-primary fw-bold">👨‍⚕️ Профіль та розклад Лікаря #@Id</h2>
            <p class="text-muted">Нижче наведено перелік запланованих прийомів цього спеціаліста.</p>
        </div>

        <div class="card shadow-sm border-0">
            <div class="card-header bg-primary text-white fw-bold">🗓️ Записи лікаря</div>
            <div class="card-body p-0">
                @if (!doctorAppointments.Any())
                {
                    <div class="p-4 text-center text-muted">Графік прийомів лікаря наразі порожній.</div>
                }
                else
                {
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>ID Запису</th>
                                <th>Дата прийому</th>
                                <th>Статус</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in doctorAppointments)
                            {
                                <tr>
                                    <td>#@app.Id</td>
                                    <td class="fw-bold">@app.AppointmentDate.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td><span class="badge bg-warning text-dark">Зайнято</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }
    private List<Profile.AppointmentDTO> doctorAppointments;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var all = await Http.GetFromJsonAsync<List<Profile.AppointmentDTO>>("api/Appointments");
            if (all != null)
            {
                // Фільтруємо записи суто для цього лікаря
                doctorAppointments = all.Where(a => a.DoctorId == Id).ToList();
            }
        }
        catch
        {
            doctorAppointments = new();
        }
    }
}